# Copy to .env and fill in what you have. Everything is optional: with an empty
# file Waymark still runs, using labelled demo and estimate-only fallbacks.
# .env is git-ignored. Never commit real keys.

# --- Server only (never exposed to the browser) ---
CLIMATIQ_API_KEY=
# Optional. Enables plain-language recommendation explanations.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional. Reserved for a container or air waybill tracking adapter.
TRACKING_PROVIDER=
TRACKING_API_KEY=

API_PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=120
UPSTREAM_TIMEOUT_MS=10000
# Shared daily Climatiq allowance for anonymous demo visitors.
DEMO_CLIMATIQ_DAILY=300

# --- Supabase (optional; enables real accounts) ---
# VITE_ values are bundled into the browser. The anon key is designed to be
# public and is safe only with row-level security, which the migration enables.
# Never put the service_role key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
