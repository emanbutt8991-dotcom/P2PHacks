# CanFirst-AI — API keys for LIVE RESEARCH (server-side only, never sent to the browser).
# EASIEST: skip this file — paste your key in the app under Live Research → AI keys → Save.
# Or: 1) Copy this file to .env.local   2) Fill in at least ONE key   3) Restart: npm run dev
# These are API keys from each company's developer site — separate from ChatGPT/Claude/Grok subscriptions.

# Claude — console.anthropic.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ChatGPT — platform.openai.com
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5

# Gemini — aistudio.google.com (has a free tier)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest

# Perplexity — perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro

# Grok — console.x.ai (no web search in this app: results are labelled INFERRED)
XAI_API_KEY=
# XAI_MODEL=grok-4

# Custom OpenAI-compatible endpoint (Agent Settings → Test Connection only)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
